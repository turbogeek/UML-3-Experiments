{
  "title": "UML3 to implementation languages, frameworks and platforms",
  "description": "Does UML3 have the constructs needed to describe software that is actually built? Each row is something a target language or platform requires, how that target spells it, and which UML3 construct covers it. The point of the table is the coverage column: GAP and TBD rows are the ones that decide whether UML3 is sufficient for code generation, and they are meant to be read, not hidden.",
  "coverageLegend": {
    "COVERED": "a UML3 construct expresses it; the construct is named in the UML3 column",
    "PARTIAL": "expressible, but with loss - the note says what is lost",
    "GAP": "no UML3 construct expresses it; a requirement is needed if it matters",
    "TBD": "not yet analyzed, or the target's current behaviour has not been confirmed"
  },
  "versionBasis": "Versions are what this machine can actually compile and run, so a claim can be tested rather than recalled: Java 21.0.8 LTS (javac 21.0.8), Rust 1.98.1 (2026-09-01), Python 3.14.4, Docker 29.2.0. No C or C++ compiler is installed here, so those two columns are analysis only and are marked TBD wherever the answer depends on compiler behaviour. Confirm the current public releases before this becomes a normative annex.",
  "targets": [
    {
      "id": "java",
      "name": "Java",
      "version": "21.0.8 LTS",
      "evidence": "tools/idl/ generates Java that javac compiles in suite idl-codegen"
    },
    {
      "id": "rust",
      "name": "Rust",
      "version": "1.98.1",
      "evidence": "tools/idl/ generates Rust that rustc compiles when present, in suite idl-codegen"
    },
    {
      "id": "python",
      "name": "Python",
      "version": "3.14.4",
      "evidence": "none yet"
    },
    {
      "id": "c",
      "name": "C",
      "version": "C23",
      "evidence": "none; no compiler on this machine"
    },
    {
      "id": "cpp",
      "name": "C++",
      "version": "C++23",
      "evidence": "none; no compiler on this machine"
    }
  ],
  "rows": [
    {
      "area": "Structure",
      "concept": "Class with state and behaviour",
      "coverage": "COVERED",
      "uml3": [
        "UML3Core::classType"
      ],
      "targets": {
        "java": "class",
        "rust": "struct + impl",
        "python": "class",
        "c": "struct + functions taking it",
        "cpp": "class"
      },
      "notes": "Rust and C separate data from behaviour; a generator emits the data type and its operations separately from one UML3 class."
    },
    {
      "area": "Structure",
      "concept": "Interface / contract without state",
      "coverage": "COVERED",
      "uml3": [
        "UML3Core::interfaceType"
      ],
      "targets": {
        "java": "interface",
        "rust": "trait",
        "python": "typing.Protocol or abc.ABC",
        "c": "struct of function pointers",
        "cpp": "abstract class / concept"
      },
      "notes": "Realization is specialization plus redefinition of every abstract operation."
    },
    {
      "area": "Structure",
      "concept": "Trait or interface with a default implementation",
      "coverage": "PARTIAL",
      "uml3": [
        "UML3Core::interfaceType"
      ],
      "targets": {
        "java": "default method",
        "rust": "trait with a provided method",
        "python": "mixin class",
        "c": "-",
        "cpp": "virtual with a body"
      },
      "notes": "An interfaceType operation may be non-abstract and carry a body, so the shape exists; UML3 says nothing about whether an implementor may override it, which is what default methods are about.",
      "layer": "metadata"
    },
    {
      "area": "Structure",
      "concept": "Abstract class",
      "coverage": "COVERED",
      "uml3": [
