        "rust": "-",
        "python": "abc.ABC",
        "c": "-",
        "cpp": "class with a pure virtual"
      },
      "notes": "'abstract' is native KerML, so no UML3 keyword is needed."
    },
    {
      "area": "Structure",
      "concept": "Value type / record / data class",
      "coverage": "COVERED",
      "uml3": [
