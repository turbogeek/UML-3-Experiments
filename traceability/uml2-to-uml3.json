{
  "title": "UML 2.5.1 to UML3 (SysML v2) traceability",
  "description": "Source of truth for how each UML 2.x concept is realized in UML3. docs/UML2-to-UML3-Traceability.md is GENERATED from this file by tools/check_traceability.py, which also verifies that every cited SysML/KerML metaclass, UML3 element, view definition and example snippet exists.",
  "statusLegend": {
    "NATIVE": "SysML v2 / KerML element used as-is; UML3 adds nothing",
    "UML3": "realized by a UML3 library element or keyword",
    "NATIVE+UML3": "native SysML v2 element, optionally refined by a UML3 keyword or library element",
    "PARTIAL": "covered with a different structure or reduced scope (see notes)",
    "NOT_ADOPTED": "deliberately not carried into UML3 (see rationale)"
  },
