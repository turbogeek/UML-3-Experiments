{
  "description": "Hypotheses about specializations implied by UML3 semantic-metadata keywords (KerML 9.2.16). 'expected' is the prediction; negative controls (expected=false) prove the check can fail. Verified in CATIA Magic by verifyImpliedSpecializations.groovy. M*/N* cases (added 2026-09-16, before running) cover marker keywords converted to semantic metadata.",
  "specializes": [
    {
      "id": "H01",
      "why": "#service part def (no explicit :>) -> Service :> Component",
      "subject": [
        "OnlineStoreArchitecture",
        "OrderService"
      ],
      "general": [
        "UML3Components",
        "Component"
      ],
      "expected": true
    },
